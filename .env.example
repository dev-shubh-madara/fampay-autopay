# ───────────────────────────────────────────────────────────────
#  FamPay Auto-Pay – copy this file to .env and fill YOUR values.
#  Never commit .env. Every value below must be your own.
# ───────────────────────────────────────────────────────────────

# ── Where buyers pay ───────────────────────────────────────────
UPI_ID=yourname@fam
PAYEE_NAME=Your Shop Name

# Fixed-price products the browser can order (id:price:Title, comma separated)
PRODUCTS=basic:29:Basic plan,pro:79:Pro plan
# false = only your backend (with API_SECRET) can create orders
ALLOW_PUBLIC_ORDERS=true

# ── Secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(32))") ──
API_SECRET=change-me-long-random-string
ADMIN_TOKEN=change-me-another-long-random-string

# ── Gmail that receives FamPay "payment received" e-mails ─────
IMAP_ENABLED=true
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=you@gmail.com
# Gmail App Password (Google Account → Security → 2-Step Verification → App passwords)
IMAP_PASSWORD=xxxx xxxx xxxx xxxx
IMAP_FOLDER=INBOX
IMAP_POLL_SECONDS=20

# Only trust mail from these senders, and only if DKIM/DMARC passes
PAYMENT_SENDERS=fampay.in,famapp.in
REQUIRE_EMAIL_AUTH=true

# ── Tell your website when an order is paid (optional) ─────────
WEBHOOK_URL=
WEBHOOK_SECRET=

# ── Server ─────────────────────────────────────────────────────
# Your website origin(s) allowed to call this API from the browser
CORS_ORIGINS=*
DATA_DIR=data
ORDER_TTL_MINUTES=60
ORDER_PREFIX=PAY
EXPOSE_DOCS=true
